SPOONACULAR_API_KEY=coloque_sua_chave_aqui
SPOONACULAR_API_HOST=spoonacular-recipe-food-nutrition-v1.p.rapidapi.com
PORT=3001

# Opcional, mas recomendado: usado para traduzir título/resumo/modo de
# preparo das receitas via OpenRouter (https://openrouter.ai) — crie uma
# conta e gere uma chave grátis em openrouter.ai/keys. Sem isso, essas
# partes da receita continuam em inglês (só os ingredientes são traduzidos).
OPENROUTER_API_KEY=

# Opcional: qual modelo gratuito do OpenRouter usar (precisa terminar em
# ":free"). Modelos gratuitos mudam de disponibilidade com frequência — se
# a tradução parar de funcionar, veja o log do backend por "Falha ao
# traduzir" e troque por outro em openrouter.ai/models?max_price=0
OPENROUTER_MODEL=nvidia/nemotron-nano-9b-v2:free
